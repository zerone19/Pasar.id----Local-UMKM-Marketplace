# Pasar.ID Backend Environment Variables
# Copy to .env and update with your local development values

# Database
DATABASE_URL="postgresql://plasaid:plasaid_secret_2026@localhost:5432/plasaid_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets (change these in production!)
JWT_SECRET="plasaid_jwt_secret_change_this_in_production"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="plasaid_refresh_secret_change_this"

# App
NODE_ENV="development"
