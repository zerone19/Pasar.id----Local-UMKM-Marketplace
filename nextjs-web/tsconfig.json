{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "baseUrl": ".",
    "plugins": [{ "name": "ts-plugin" }],
    "lib": ["DOM", "ES2022"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", ".next"]
}
